  def queue_with_priority(priority = T.unsafe(nil), &block); end

  class << self
    # pkg:gem/activejob#lib/active_job/queue_priority.rb:9
    def default_priority; end

    # pkg:gem/activejob#lib/active_job/queue_priority.rb:9
    def default_priority=(val); end
  end
end

